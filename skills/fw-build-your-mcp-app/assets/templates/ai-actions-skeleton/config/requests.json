{
  "getResource": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.api_base_url %>",
      "path": "/api/v1/resources/<%= context.resource_id %>",
      "headers": {
        "Authorization": "Bearer <%= iparam.api_key %>",
        "Accept": "application/json"
      }
    }
  },
  "createResource": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.api_base_url %>",
      "path": "/api/v1/resources",
      "headers": {
        "Authorization": "Bearer <%= iparam.api_key %>",
        "Content-Type": "application/json",
        "Accept": "application/json"
      }
    }
  }
}
