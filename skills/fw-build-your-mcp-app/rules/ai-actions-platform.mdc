## server.js Pattern

```javascript
const __formatError = (error, functionName) => {
  console.error(`[${functionName}] Error:`, error);
  let message;
  try {
    message = error.response ? JSON.parse(error.response) : error.message;
  } catch {
    message = error.response || error.message || 'Unknown error';
  }
  return { status: error.status || 500, message: typeof message === 'object' ? JSON.stringify(message) : message };
};

exports = {
  actionName: async function(args) {
    try {
      const { param1 } = args;
      const response = await $request.invokeTemplate('requestTemplateName', {
        context: { param1: param1 },
        body: JSON.stringify({ ... })  // if POST/PUT
      });
      const data = JSON.parse(response.response);
      renderData(null, data);
    } catch (error) {
      renderData(__formatError(error, 'actionName'), null);
    }
  }
};
```

**renderData signature:** `renderData(error, data)`
- Success: `renderData(null, data)`
- Error: `renderData({ status, message }, null)`

**Rules:**
- ✅ Helper functions BEFORE exports allowed
- ✅ Use `$request.invokeTemplate()` - NEVER $request.post/get/put/delete
- ✅ Access iparams via `args.iparams` in server (or use iparam in request template)
- ✅ Create test_data/actionName.json for each action

