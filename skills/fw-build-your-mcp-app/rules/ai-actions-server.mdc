# MCP app server.js Patterns

## Platform 3.0 pattern

```javascript
const __formatError = (error, functionName) => {
  console.error(`[${functionName}] Error:`, error);
  let message;
  try {
    message = error.response ? JSON.parse(error.response) : error.message;
  } catch {
    message = error.response || error.message || 'Unknown error';
  }
  const parsedMessage = message instanceof Object ? JSON.stringify(message) : message;
  return { status: error.status || 500, message: parsedMessage };
};

exports = {
  actionName: async function(args) {
    try {
      const { param1 } = args;
      const response = await $request.invokeTemplate('templateName', {
        context: { param1: param1 },
        body: JSON.stringify({ ... })  // if POST/PUT
      });
      const data = JSON.parse(response.response);
      renderData(null, data);
    } catch (error) {
      renderData(__formatError(error, 'actionName'), null);
    }
  }
};
```

## Error messages surfaced to users

**Sanitize before `renderData`:** Vendor error payloads may contain internal URLs, stack traces, tokens, or other sensitive data. Strip or map them to **short, user-safe** strings for the `message` passed to `renderData`; log the full error server-side only.

## renderData Signature

`renderData(error, data)`

- **Success:** `renderData(null, data)` — pass parsed response directly
- **Error:** `renderData({ status, message }, null)`

## Rules

1. **Helper functions** — Can be defined BEFORE exports
2. **$request.invokeTemplate()** — Use only; never .post/.get/.put/.delete
3. **context** — For path/query params: `context: { id: args.id }`
4. **body** — For POST/PUT: `body: JSON.stringify(requestBody)`
5. **query** — For GET query params: `query: { page: 1 }`
6. **Function name** — Must match actions.json key exactly (case-sensitive)

## Modular server layout

Keep **`server/server.js`** focused on **SMI exports** (`exports = { ... }`) and thin handlers. Move reusable logic into additional modules under **`server/services/`**, **`server/lib/`**, or similar, and **`require()`** them from `server.js`. This keeps complexity down and matches how npm dependencies are loaded from serverless code ([Use external libraries](https://developers.freshworks.com/docs/app-sdk/v3.0/service_change/basic-dev-tools/external-libraries/)).

```javascript
const { buildPayload, mapVendorError } = require('./services/integration');

exports = {
  createItem: async function (args) {
    try {
      const body = buildPayload(args);
      const res = await $request.invokeTemplate('createItem', {
        body: JSON.stringify(body)
      });
      renderData(null, JSON.parse(res.response));
    } catch (error) {
      renderData(mapVendorError(error, 'createItem'), null);
    }
  }
};
```

## Key-value storage (`$db`)

Use the platform **KV store** for small JSON state per installation (caching, mappings, flags). Serverless runtime: **`$db.get`**, **`$db.set`**, **`$db.delete`** (and **`$db.update`** where needed). See [Data store overview](https://developers.freshworks.com/docs/app-sdk/v3.0/service_change/data-store/) and [Key-value storage](https://developers.freshworks.com/docs/app-sdk/v3.0/service_change/data-store/key-value-storage/).

- **`$db.set(key, value, options)`** — optional **`ttl`** (seconds) for ephemeral data; keys ≤ **60** characters; key+value size limits per docs (**40 KB** combined in v3 KV docs).
- **Rate limit:** **50** set/get/delete operations per minute per installed app (see KV doc).
- Do not store secrets in KV if a **secure iparam** or OAuth token is the right place; KV is for non-sensitive or already-issued tokens you choose to cache (see below).

## Caching access tokens (`invokeTemplate` + `$db`)

**`invokeTemplate()`** response **cache/ttl** in platform docs applies to **front-end** caching behavior, not a built-in serverless OAuth token store. For **serverless**, fetch tokens with **`$request.invokeTemplate`** (token endpoint template), then persist the result with **`$db.set(..., { ttl })`** so you respect vendor `expires_in` and reduce rate-limit pressure.

```javascript
const TOKEN_KEY = 'vendor_oauth_token';

async function getVendorAccessToken(args) {
  const existing = await $db.get(TOKEN_KEY);
  if (existing?.access_token) {
    return existing.access_token;
  }
  const tokenRes = await $request.invokeTemplate('vendorToken', {
    body: JSON.stringify({
      grant_type: 'client_credentials',
      client_id: args.iparams.client_id,
      client_secret: args.iparams.client_secret
    })
  });
  const data = JSON.parse(tokenRes.response);
  const ttl = Math.max(60, (data.expires_in || 3600) - 120);
  await $db.set(TOKEN_KEY, { access_token: data.access_token }, { ttl });
  return data.access_token;
}
```

Adapt the template name, body shape, and iparam names to the provider. Prefer **OAuth in `oauth_config.json`** when the platform can manage refresh; use this pattern when you must cache a **custom** token response.

## JWT signing for outbound calls (optional)

To sign a JWT before calling a vendor that expects **`Authorization: Bearer <jwt>`**, use the **`jsonwebtoken`** package as described in [Use external libraries — JWT](https://developers.freshworks.com/docs/app-sdk/v3.0/service_change/basic-dev-tools/external-libraries/). Register it in **`manifest.json` `dependencies`**. **Never** hardcode signing secrets — use a **secure iparam** (or key material the installer provides).

**manifest.json:**
```json
{
  "dependencies": {
    "jsonwebtoken": "9.0.2"
  }
}
```

**config/requests.json** — pass the signed token via **context** (not hardcoded):

```json
{
  "vendorMutation": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.vendor_host %>",
      "path": "/v1/mutation",
      "headers": {
        "Authorization": "Bearer <%= context.signed_jwt %>",
        "Content-Type": "application/json"
      }
    }
  }
}
```

**server.js** (sketch):

```javascript
const jwt = require('jsonwebtoken');

exports = {
  pushToVendor: async function (args) {
    try {
      const signingSecret = args.iparams.jwt_signing_secret;
      const signed_jwt = jwt.sign(
        { sub: 'freshworks-app', iat: Math.floor(Date.now() / 1000) },
        signingSecret,
        { algorithm: 'HS256', expiresIn: '5m' }
      );
      const vendorRes = await $request.invokeTemplate('vendorMutation', {
        context: { signed_jwt },
        body: JSON.stringify({ event: args.event_type })
      });
      renderData(null, JSON.parse(vendorRes.response));
    } catch (error) {
      renderData(__formatError(error, 'pushToVendor'), null);
    }
  }
};
```

Use **short `expiresIn`**, the **algorithm your vendor requires** (HS256 vs RS256 + private key), and **never** log secrets or full JWTs.

## Optional Params Helper

```javascript
const _addOptionalProperty = (obj, key, value) => {
  if (value !== undefined && value !== null) {
    obj[key] = value;
  }
};

// Usage: build request body with only provided fields
const body = {};
_addOptionalProperty(body, 'name', args.name);
_addOptionalProperty(body, 'email', args.email);
```

## Constructing Nested/Array for API

When API requires nested structure, build in server.js:
```javascript
const requestBody = {
  contact: {
    name: args.name,
    email: args.email
  }
};
// or
const requestBody = {
  items: [args.item1, args.item2].filter(Boolean)
};
```

## SOAP Integration Pattern

For SOAP APIs, use `strong-soap` + request templates hybrid:

```javascript
const { soap } = require('strong-soap');
const wsdlClientCache = new Map();

function escapeXml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

async function getWsdlClient(service, args) {
  const wsdlUrl = `https://${args.iparams.host}/${service}?wsdl`;
  const cacheKey = `${service}:${wsdlUrl}`;
  
  if (wsdlClientCache.has(cacheKey)) {
    return wsdlClientCache.get(cacheKey);
  }

  try {
    const client = await new Promise((resolve, reject) => {
      soap.createClient(wsdlUrl, {}, (error, client) => {
        error ? reject(error) : resolve(client);
      });
    });
    wsdlClientCache.set(cacheKey, client);
    return client;
  } catch (error) {
    console.warn(`[SOAP] WSDL load failed for ${service}:`, error.message);
    return null;
  }
}

function buildSoapEnvelope(operation, innerXml, namespace = 'urn:namespace') {
  return `<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ns="${namespace}">
  <soapenv:Body>
    <ns:${operation}_Request>
      ${innerXml}
    </ns:${operation}_Request>
  </soapenv:Body>
</soapenv:Envelope>`;
}

function getSoapFault(xml, wsdlClient) {
  if (wsdlClient?.wsdl?.xmlToObject) {
    try {
      const parsed = wsdlClient.wsdl.xmlToObject(xml);
      const fault = extractFaultFromObject(parsed);
      if (fault) return fault;
    } catch (error) {
      console.warn('[SOAP] xmlToObject fallback:', error.message);
    }
  }
  
  const faultMatch = xml.match(/<faultstring>([^<]*)<\/faultstring>/);
  return faultMatch ? faultMatch[1] : null;
}

async function invokeSoapOperation({ service, operation, requestInnerXml, args }) {
  const wsdlClient = await getWsdlClient(service, args);
  const envelope = buildSoapEnvelope(operation, requestInnerXml);
  
  const { response } = await $request.invokeTemplate('soapRequest', {
    context: {
      soap_service: service,
      soap_action: `urn:namespace/${operation}`
    },
    body: envelope
  });

  const fault = getSoapFault(response, wsdlClient);
  if (fault) {
    throw { status: 400, message: fault, response };
  }
  
  return response;
}

exports = {
  soapAction: async function(args) {
    try {
      const xml = await invokeSoapOperation({
        service: 'MyService',
        operation: 'GetData',
        requestInnerXml: `<id>${escapeXml(args.id)}</id>`,
        args
      });
      
      const results = xml.match(/<result>([^<]*)<\/result>/g) || [];
      renderData(null, { results: results.map(r => r.replace(/<\/?result>/g, '')) });
    } catch (error) {
      renderData(__formatError(error, 'soapAction'), null);
    }
  }
};
```

**Declare in manifest.json:**
```json
{
  "dependencies": {
    "strong-soap": "4.1.14"
  }
}
```
